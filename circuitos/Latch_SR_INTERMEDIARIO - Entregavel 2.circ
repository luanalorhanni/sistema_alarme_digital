    <comp lib="3" loc="(80,605)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="text" val="1. Clique em SENSOR (vai para 1) → simula 'porta fechada' (reed switch ativo)"/>
    </comp>
    <comp lib="3" loc="(80,625)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="text" val="2. Clique em RESET (vai para 1) e depois solte → inicializa o sistema (LED VERDE acende)"/>
    </comp>
    <comp lib="3" loc="(80,645)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="text" val="3. Clique em SENSOR de volta para 0 → simula 'porta aberta' → LED VERMELHO + BUZZER acionam!"/>
