    <comp lib="3" loc="(80,665)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="text" val="4. Clique em SENSOR para 1 novamente → ALARME continua ativo (MEMÓRIA do Latch SR!)"/>
